# ─────────────────────────────────────────────────────────────────────────────
#  JARVIS Personal AI OS — Environment Configuration
#  Copy this file to .env and fill in your values.
#  Run `python jarvis.py --setup` for the interactive wizard instead.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED — FREE at https://console.groq.com/ ─────────────────────────────
GROQ_API_KEY="gsk_..."

# ── AI MODEL (Groq free models) ───────────────────────────────────────────────
# llama-3.3-70b-versatile   ← best quality (recommended)
# llama-3.1-8b-instant      ← fastest / lightest
# mixtral-8x7b-32768        ← good for long context
JARVIS_MODEL="llama-3.3-70b-versatile"

# ── SERVER PORTS ─────────────────────────────────────────────────────────────
JARVIS_WS_PORT="8765"
JARVIS_HTTP_PORT="8766"

# ── EMAIL (optional) ─────────────────────────────────────────────────────────
# Gmail: enable 2FA → App Password at myaccount.google.com/apppasswords
# Outlook: use smtp.office365.com / outlook.office365.com
EMAIL_ADDRESS=""
EMAIL_PASSWORD=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
IMAP_HOST="imap.gmail.com"
IMAP_PORT="993"

# ── VOICE (optional) ─────────────────────────────────────────────────────────
# STT engine: google (needs internet) | whisper (offline, pip install openai-whisper)
JARVIS_STT_ENGINE="google"
# Wake word to trigger voice commands
JARVIS_WAKE_WORD="hey jarvis"
# TTS speech rate (words per minute)
JARVIS_TTS_RATE="165"

# ── BROWSER (optional) ───────────────────────────────────────────────────────
# Path to Chrome/Firefox binary if not in PATH
# CHROME_BINARY="/usr/bin/google-chrome"
# Run browser in headless mode (no visible window)
JARVIS_BROWSER_HEADLESS="false"

# ── AI MODEL ─────────────────────────────────────────────────────────────────
JARVIS_MODEL="claude-sonnet-4-20250514"
JARVIS_MAX_TOKENS="1024"

# ── LOGGING ──────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
JARVIS_LOG_LEVEL="INFO"
# Log file path (leave blank to log to console only)
JARVIS_LOG_FILE=""
